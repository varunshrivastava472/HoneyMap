# HoneyMap Global Environment Configuration Example

# Backend Server Configuration
HONEYMAP_HOST=0.0.0.0
HONEYMAP_PORT=5000
HONEYMAP_DB_PATH=honeymap.db

# Security & Rate Limiting (Requests per 60-second window per IP)
HONEYMAP_RATE_LIMIT_MAX=300

# GeoIP Network Lookup Timeout in Seconds (falls back to OFFLINE_FALLBACK)
HONEYMAP_GEOIP_TIMEOUT=2.0

# Allowed CORS Origins (comma-separated list, e.g. http://localhost:5173,https://honeymap.internal)
HONEYMAP_CORS_ORIGINS=http://localhost:5173

# Frontend Environment Variables
VITE_API_BASE=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
