# HoneyMap Backend Environment Configuration

# Server Bind Address & Port
HONEYMAP_HOST=0.0.0.0
HONEYMAP_PORT=5000

# SQLite Database Location
HONEYMAP_DB_PATH=honeymap.db

# Rate Limiting: Max requests per IP within a 60-second sliding window
HONEYMAP_RATE_LIMIT_MAX=300

# GeoIP Network Lookup Timeout in Seconds (falls back gracefully to OFFLINE_FALLBACK)
HONEYMAP_GEOIP_TIMEOUT=2.0

# Scoped CORS Allowed Origins (comma-separated, never wildcard *)
HONEYMAP_CORS_ORIGINS=http://localhost:5173
